# Copy to backend/.env and fill in. Never commit the real .env.
# Note: Claude Pro (claude.ai) is NOT the same as Anthropic API access — get a key
# (with its own billing) from console.anthropic.com/settings/keys.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=tAtHhBlA3E0eKZJKNSKE
ELEVENLABS_STT_MODEL=scribe_v2

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Personal access token for the Supabase Management API (used once, to
# provision the project — not needed at runtime after that).
SUPABASE_MANAGEMENT_TOKEN=
